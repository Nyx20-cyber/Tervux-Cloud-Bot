# ==============================================
# Tervux WhatsApp Bot - Local Development Example
# ==============================================

# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb+srv://username:password@cluster0.example.mongodb.net/tervux-bot?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=change_me_local_jwt_secret

# FastLipa Payment Gateway
FASTLIPA_API_TOKEN=change_me_fastlipa_api_token
FASTLIPA_WEBHOOK_SECRET=change_me_fastlipa_webhook_secret

# AI Configuration
AI_API_KEY=change_me_ai_api_key
AI_API_BASE_URL=https://open.bigmodel.cn/api/paas/v4/

# BongoPay Payment Gateway
BONGOPAY_API_KEY=change_me_bongopay_api_key
BONGOPAY_BASE_URL=https://bongopay.io
BONGOPAY_WEBHOOK_URL=https://bot.tervux.com/api/subscription/webhooks/bongopay
BONGOPAY_REDIRECT_URL=https://bot.tervux.com/dashboard/billing

# Admin Account
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!

# Web Push Notifications (VAPID)
WEB_PUSH_VAPID_PUBLIC_KEY=change_me_web_push_public_key
WEB_PUSH_VAPID_PRIVATE_KEY=change_me_web_push_private_key
WEB_PUSH_VAPID_SUBJECT=mailto:support@tervux.com
