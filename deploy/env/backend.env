NODE_ENV=production
PORT=5000
TRUST_PROXY=1

# Mongo inside docker network
MONGODB_URI=mongodb://tervux_admin:change_me_mongo@mongo:27017/tervux_bot?authSource=admin

JWT_SECRET=change_me_super_strong_secret
CORS_ORIGINS=https://bot.tervux.com,https://www.bot.tervux.com

# FastLipa
FASTLIPA_API_TOKEN=change_me_fastlipa_api_token
FASTLIPA_WEBHOOK_SECRET=change_me_fastlipa_webhook_secret
FASTLIPA_REQUEST_TIMEOUT_MS=15000
FASTLIPA_STATUS_MAX_RETRIES=3
FASTLIPA_RETRY_BASE_MS=1200

# BongoPay card payments (international)
BONGOPAY_API_KEY=change_me_bongopay_api_key
BONGOPAY_BASE_URL=https://bongopay.io
BONGOPAY_WEBHOOK_URL=https://api.bot.tervux.com/api/subscription/webhooks/bongopay
BONGOPAY_REDIRECT_URL=https://bot.tervux.com/dashboard/billing
BONGOPAY_TIMEOUT_MS=20000

FRONTEND_URL=https://bot.tervux.com
WEB_PUSH_VAPID_PUBLIC_KEY=change_me_web_push_public_key
WEB_PUSH_VAPID_PRIVATE_KEY=change_me_web_push_private_key
WEB_PUSH_VAPID_SUBJECT=mailto:support@tervux.com
DEPLOY_REMINDER_COOLDOWN_MS=86400000


# Redis
REDIS_URL=redis://:change_me_redis@redis:6379
SETTINGS_CACHE_TTL_SECONDS=30

# App seed/admin
ADMIN_EMAIL=admin@tervux.com
ADMIN_PASSWORD=ChangeMe123!
